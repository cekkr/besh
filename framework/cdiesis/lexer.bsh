# cdiesis/lexer.bsh - Source text to token stream.
#
# STATUS: experimental implementation (see framework/cdiesis.bsh header).
#
# The lexer walks the source with a single character cursor and appends tokens
# to a flat, name-mangled array. It never uses the shell's own tokenizer: a
# language framework has to own its notation completely, otherwise "loading a
# language" would mean "patching the C parser", which is exactly what B[e]SH's
# runtime-extensibility research is trying to avoid.
#
# TOKEN KINDS
#   KW    reserved word            ID   identifier
#   NUM   numeric literal          STR  string literal (value is a pool ref)
#   CHR   character literal        OP   operator
#   PUNCT ( ) { } [ ] ; , .        EOF  end of unit
#
# STORAGE
#   CDS_TK_<unit>_N            token count
#   CDS_TK_<unit>_<i>_K        kind
#   CDS_TK_<unit>_<i>_V        text (or "k<n>" for STR)
#   CDS_TK_<unit>_<i>_L        source line
#   CDS_LEX_POS / _LINE / _SRC cursor state of the lexer in flight

echo "Loading cDiesis lexer (cdiesis/lexer.bsh)..."

$(CDS_NL) = "\n"
$(CDS_TAB) = "\t"
$(CDS_QUOTE) = "\""

function cds_tok_add (unit kind value line) {
    $count_slot = "CDS_TK_${unit}_N"
    $idx = $($count_slot)
    if $idx == "" {
        $idx = "0"
    }
    $kind_slot = "CDS_TK_${unit}_${idx}_K"
    $($kind_slot) = "$kind"
    $value_slot = "CDS_TK_${unit}_${idx}_V"
    $($value_slot) = "$value"
    $line_slot = "CDS_TK_${unit}_${idx}_L"
    $($line_slot) = "$line"
    $next = $idx + 1
    $($count_slot) = "$next"
}

function cds_tokens_drop (unit) {
    $count_slot = "CDS_TK_${unit}_N"
    $count = $($count_slot)
    $idx = "0"
    while $idx < $count {
        $kind_slot = "CDS_TK_${unit}_${idx}_K"
        $($kind_slot) = ""
        $value_slot = "CDS_TK_${unit}_${idx}_V"
        $($value_slot) = ""
        $line_slot = "CDS_TK_${unit}_${idx}_L"
        $($line_slot) = ""
        $idx = $idx + 1
    }
    $($count_slot) = "0"
}

function cds_tok_kind (unit index result_var) {
    $slot = "CDS_TK_${unit}_${index}_K"
    $($result_var) = $($slot)
}

function cds_tok_value (unit index result_var) {
    $slot = "CDS_TK_${unit}_${index}_V"
    $($result_var) = $($slot)
}

function cds_tok_line (unit index result_var) {
    $slot = "CDS_TK_${unit}_${index}_L"
    $($result_var) = $($slot)
}

# --- Keywords -------------------------------------------------------------
#
# Recognised as a table lookup rather than a chain of comparisons so that the
# set is data, not control flow: a dialect could extend it at load time without
# touching the lexer, which is the whole point of a loadable language.

function cds_lex_init_keywords () {
    # Reserve result holders in this frame: a callee writes its result
    # into the innermost scope that already defines the name.
    $count = ""
    $word = ""
    $(CDS_KW_LIST) = "namespace using class struct interface extern static public private protected internal virtual override abstract const readonly new return if else while for foreach in break continue this base null true false void var int long float double bool char string object"
    cds_str_field_count "$CDS_KW_LIST" count
    $idx = "0"
    while $idx < $count {
        cds_str_field "$CDS_KW_LIST" "$idx" word
        $slot = "CDS_KW_${word}"
        $($slot) = "1"
        $idx = $idx + 1
    }
}

function cds_is_keyword (word result_var) {
    $slot = "CDS_KW_${word}"
    if $($slot) == "1" {
        $($result_var) = "1"
    } else {
        $($result_var) = "0"
    }
}

# --- Main scan ------------------------------------------------------------

function cds_lex (unit result_var) {
    # Reserve result holders in this frame: a callee writes its result
    # into the innermost scope that already defines the name.
    $total = ""
    $ch = ""
    $is_space = ""
    cds_lex_init_keywords
    cds_tokens_drop "$unit"

    $src_slot = "CDS_U_${unit}_SRC"
    $(CDS_LEX_SRC) = $($src_slot)
    $(CDS_LEX_POS) = "0"
    $(CDS_LEX_LINE) = "1"
    $(CDS_LEX_UNIT) = "$unit"
    $(CDS_LEX_ERROR) = ""

    cds_str_len "$CDS_LEX_SRC" total
    $(CDS_LEX_LEN) = "$total"

    while $CDS_LEX_POS < $CDS_LEX_LEN {
        cds_str_char_at "$CDS_LEX_SRC" "$CDS_LEX_POS" ch

        cds_char_is_space "$ch" is_space
        if $ch == "$CDS_NL" {
            $(CDS_LEX_LINE) = $CDS_LEX_LINE + 1
            $is_space = "1"
        }
        if $is_space == "1" {
            $(CDS_LEX_POS) = $CDS_LEX_POS + 1
        } else {
            cds_lex_one "$unit" "$ch"
        }

        if $CDS_LEX_ERROR != "" {
            echo "cDiesis lex error (line $CDS_LEX_LINE): $CDS_LEX_ERROR"
            $($result_var) = "0"
            return
        }
    }

    cds_tok_add "$unit" "EOF" "" "$CDS_LEX_LINE"
    $($result_var) = "1"
}

function cds_lex_one (unit ch) {
    # Reserve result holders in this frame: a callee writes its result
    # into the innermost scope that already defines the name.
    $handled = ""
    $is_digit = ""
    $is_ident = ""
    if $ch == "/" {
        cds_lex_maybe_comment "$unit" handled
        if $handled == "1" {
            return
        }
    }
    if $ch == "$CDS_QUOTE" {
        cds_lex_string "$unit"
        return
    }
    if $ch == "'" {
        cds_lex_char "$unit"
        return
    }

    cds_char_is_digit "$ch" is_digit
    if $is_digit == "1" {
        cds_lex_number "$unit"
        return
    }

    cds_char_is_ident_start "$ch" is_ident
    if $is_ident == "1" {
        cds_lex_word "$unit"
        return
    }

    cds_lex_punct_or_op "$unit" "$ch"
}

function cds_lex_maybe_comment (unit result_var) {
    # Reserve result holders in this frame: a callee writes its result
    # into the innermost scope that already defines the name.
    $next_ch = ""
    $ch = ""
    $ch2 = ""
    $next_pos = $CDS_LEX_POS + 1
    cds_str_char_at "$CDS_LEX_SRC" "$next_pos" next_ch

    if $next_ch == "/" {
        while $CDS_LEX_POS < $CDS_LEX_LEN {
            cds_str_char_at "$CDS_LEX_SRC" "$CDS_LEX_POS" ch
            if $ch == "$CDS_NL" {
                $($result_var) = "1"
                return
            }
            $(CDS_LEX_POS) = $CDS_LEX_POS + 1
        }
        $($result_var) = "1"
        return
    }

    if $next_ch == "*" {
        $(CDS_LEX_POS) = $CDS_LEX_POS + 2
        while $CDS_LEX_POS < $CDS_LEX_LEN {
            cds_str_char_at "$CDS_LEX_SRC" "$CDS_LEX_POS" ch
            if $ch == "$CDS_NL" {
                $(CDS_LEX_LINE) = $CDS_LEX_LINE + 1
            }
            if $ch == "*" {
                $peek = $CDS_LEX_POS + 1
                cds_str_char_at "$CDS_LEX_SRC" "$peek" ch2
                if $ch2 == "/" {
                    $(CDS_LEX_POS) = $CDS_LEX_POS + 2
                    $($result_var) = "1"
                    return
                }
            }
            $(CDS_LEX_POS) = $CDS_LEX_POS + 1
        }
        $(CDS_LEX_ERROR) = "unterminated block comment"
        $($result_var) = "1"
        return
    }

    $($result_var) = "0"
}

# String literals are interned into the unit's constant pool immediately, and
# the token carries only the pool reference. Op strings stay whitespace-safe as
# a result, which is what keeps the primitive encoding flat.
function cds_lex_string (unit) {
    # Reserve result holders in this frame: a callee writes its result
    # into the innermost scope that already defines the name.
    $ch = ""
    $ref = ""
    $escaped = ""
    $decoded = ""
    $(CDS_LEX_POS) = $CDS_LEX_POS + 1
    $value = ""
    while $CDS_LEX_POS < $CDS_LEX_LEN {
        cds_str_char_at "$CDS_LEX_SRC" "$CDS_LEX_POS" ch
        if $ch == "$CDS_QUOTE" {
            $(CDS_LEX_POS) = $CDS_LEX_POS + 1
            cds_pool_add "$unit" "$value" ref
            cds_tok_add "$unit" "STR" "$ref" "$CDS_LEX_LINE"
            return
        }
        if $ch == "\\" {
            $(CDS_LEX_POS) = $CDS_LEX_POS + 1
            cds_str_char_at "$CDS_LEX_SRC" "$CDS_LEX_POS" escaped
            cds_lex_unescape "$escaped" decoded
            $value = "$value$decoded"
        } else {
            $value = "$value$ch"
        }
        $(CDS_LEX_POS) = $CDS_LEX_POS + 1
    }
    $(CDS_LEX_ERROR) = "unterminated string literal"
}

function cds_lex_unescape (ch result_var) {
    if $ch == "n" { $($result_var) = "$CDS_NL"; return }
    if $ch == "t" { $($result_var) = "$CDS_TAB"; return }
    if $ch == "0" { $($result_var) = ""; return }
    $($result_var) = "$ch"
}

function cds_lex_char (unit) {
    # Reserve result holders in this frame: a callee writes its result
    # into the innermost scope that already defines the name.
    $ch = ""
    $escaped = ""
    $closing = ""
    $ref = ""
    $(CDS_LEX_POS) = $CDS_LEX_POS + 1
    cds_str_char_at "$CDS_LEX_SRC" "$CDS_LEX_POS" ch
    if $ch == "\\" {
        $(CDS_LEX_POS) = $CDS_LEX_POS + 1
        cds_str_char_at "$CDS_LEX_SRC" "$CDS_LEX_POS" escaped
        cds_lex_unescape "$escaped" ch
    }
    $(CDS_LEX_POS) = $CDS_LEX_POS + 1
    cds_str_char_at "$CDS_LEX_SRC" "$CDS_LEX_POS" closing
    if $closing != "'" {
        $(CDS_LEX_ERROR) = "unterminated character literal"
        return
    }
    $(CDS_LEX_POS) = $CDS_LEX_POS + 1
    cds_pool_add "$unit" "$ch" ref
    cds_tok_add "$unit" "CHR" "$ref" "$CDS_LEX_LINE"
}

function cds_lex_number (unit) {
    # Reserve result holders in this frame: a callee writes its result
    # into the innermost scope that already defines the name.
    $ch = ""
    $is_digit = ""
    $seen_dot = "0"
    while $CDS_LEX_POS < $CDS_LEX_LEN {
        cds_str_char_at "$CDS_LEX_SRC" "$CDS_LEX_POS" ch
        cds_char_is_digit "$ch" is_digit
        if $is_digit == "1" {
            $value = "$value$ch"
            $(CDS_LEX_POS) = $CDS_LEX_POS + 1
        } else {
            if $ch == "." {
                if $seen_dot == "1" {
                    cds_tok_add "$unit" "NUM" "$value" "$CDS_LEX_LINE"
                    return
                }
                $seen_dot = "1"
                $value = "$value$ch"
                $(CDS_LEX_POS) = $CDS_LEX_POS + 1
            } else {
                cds_tok_add "$unit" "NUM" "$value" "$CDS_LEX_LINE"
                return
            }
        }
    }
    cds_tok_add "$unit" "NUM" "$value" "$CDS_LEX_LINE"
}

function cds_lex_word (unit) {
    # Reserve result holders in this frame: a callee writes its result
    # into the innermost scope that already defines the name.
    $ch = ""
    $is_part = ""
    while $CDS_LEX_POS < $CDS_LEX_LEN {
        cds_str_char_at "$CDS_LEX_SRC" "$CDS_LEX_POS" ch
        cds_char_is_ident_part "$ch" is_part
        if $is_part != "1" {
            cds_lex_emit_word "$unit" "$value"
            return
        }
        $value = "$value$ch"
        $(CDS_LEX_POS) = $CDS_LEX_POS + 1
    }
    cds_lex_emit_word "$unit" "$value"
}

function cds_lex_emit_word (unit value) {
    # Reserve result holders in this frame: a callee writes its result
    # into the innermost scope that already defines the name.
    $is_kw = ""
    cds_is_keyword "$value" is_kw
    if $is_kw == "1" {
        cds_tok_add "$unit" "KW" "$value" "$CDS_LEX_LINE"
    } else {
        cds_tok_add "$unit" "ID" "$value" "$CDS_LEX_LINE"
    }
}

# Two-character operators are matched first so that "==" never lexes as two
# assignments and "<=" never as a generic bracket followed by '='.
function cds_lex_punct_or_op (unit ch) {
    # Reserve result holders in this frame: a callee writes its result
    # into the innermost scope that already defines the name.
    $next_ch = ""
    $peek = $CDS_LEX_POS + 1
    cds_str_char_at "$CDS_LEX_SRC" "$peek" next_ch
    $pair = "$ch$next_ch"

    $is_pair = "0"
    if $pair == "==" { $is_pair = "1" }
    if $pair == "!=" { $is_pair = "1" }
    if $pair == "<=" { $is_pair = "1" }
    if $pair == ">=" { $is_pair = "1" }
    if $pair == "&&" { $is_pair = "1" }
    if $pair == "||" { $is_pair = "1" }
    if $pair == "++" { $is_pair = "1" }
    if $pair == "--" { $is_pair = "1" }
    if $pair == "+=" { $is_pair = "1" }
    if $pair == "-=" { $is_pair = "1" }
    if $pair == "*=" { $is_pair = "1" }
    if $pair == "/=" { $is_pair = "1" }
    if $pair == "=>" { $is_pair = "1" }

    if $is_pair == "1" {
        cds_tok_add "$unit" "OP" "$pair" "$CDS_LEX_LINE"
        $(CDS_LEX_POS) = $CDS_LEX_POS + 2
        return
    }

    $is_punct = "0"
    if $ch == "(" { $is_punct = "1" }
    if $ch == ")" { $is_punct = "1" }
    if $ch == "{" { $is_punct = "1" }
    if $ch == "}" { $is_punct = "1" }
    if $ch == "[" { $is_punct = "1" }
    if $ch == "]" { $is_punct = "1" }
    if $ch == ";" { $is_punct = "1" }
    if $ch == "," { $is_punct = "1" }
    if $ch == "." { $is_punct = "1" }
    if $ch == ":" { $is_punct = "1" }

    if $is_punct == "1" {
        cds_tok_add "$unit" "PUNCT" "$ch" "$CDS_LEX_LINE"
    } else {
        cds_tok_add "$unit" "OP" "$ch" "$CDS_LEX_LINE"
    }
    $(CDS_LEX_POS) = $CDS_LEX_POS + 1
}

echo "cDiesis lexer loaded."
