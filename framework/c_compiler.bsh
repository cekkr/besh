# BSH C Compiler Framework (c_compiler.bsh)
#
# Defines, compiles and loads C source held in a BSH variable as a shared
# library, using three shell primitives: 'writefile' to place the source on
# disk, external command execution to run the compiler, and 'loadlib' to bring
# the result into the process.
#
# The C ABI a compiled library must follow is fixed by bsh.c:
#   int func_name(int argc, char* argv[], char* output_buffer, int buffer_size)
# and results come back through $LAST_LIB_CALL_STATUS / $LAST_LIB_CALL_OUTPUT.
#
# This module is NOT used during startup: .bshrc keeps numbers and strings on
# the built-in primitives so that a plain shell session never depends on a C
# compiler being installed.
echo "Loading C Compiler Framework (c_compiler.bsh)..."

# --- Configuration ---
$BSH_C_COMPILE_TEMP_DIR = "/tmp/bsh_compile_cache"
$BSH_C_COMPILER = "cc"

# --- Main Function: Define, Compile, and Load C Library ---
# def_c_lib <alias> <c_code_var_name> [cflags_var_name] [ldflags_var_name]
#
# Sets, for alias X:
#   $X_COMPILE_STATUS   "success" | "failure"
#   $X_LOAD_STATUS      "success" | "failure"
#   $X_PATH             path of the produced shared object
function def_c_lib (lib_alias c_code_var_name compiler_flags_var linker_flags_var) {
    echo "def_c_lib: building '$lib_alias'..."

    $c_source_code = $($c_code_var_name)
    if $c_source_code == "" {
        echo "def_c_lib: C source variable '$c_code_var_name' is empty."
        $($lib_alias)_COMPILE_STATUS = "failure"
        $($lib_alias)_LOAD_STATUS = "failure"
        return
    }

    mkdir -p "$BSH_C_COMPILE_TEMP_DIR"

    $source_file_path = "${BSH_C_COMPILE_TEMP_DIR}/${lib_alias}.c"
    $output_lib_path = "${BSH_C_COMPILE_TEMP_DIR}/${lib_alias}.so"

    writefile "$source_file_path" $c_code_var_name
    if $LAST_FILE_STATUS != "0" {
        echo "def_c_lib: could not write '$source_file_path'."
        $($lib_alias)_COMPILE_STATUS = "failure"
        $($lib_alias)_LOAD_STATUS = "failure"
        return
    }

    $cflags = ""
    if $compiler_flags_var != "" {
        $cflags = $($compiler_flags_var)
    }
    $ldflags = ""
    if $linker_flags_var != "" {
        $ldflags = $($linker_flags_var)
    }

    # Paths are passed as quoted strings so the tokenizer keeps them whole.
    $BSH_C_COMPILER "-shared" "-fPIC" "-o" "$output_lib_path" "$source_file_path" $cflags $ldflags

    if $LAST_COMMAND_STATUS != "0" {
        echo "def_c_lib: compilation of '$lib_alias' failed (status $LAST_COMMAND_STATUS)."
        $($lib_alias)_COMPILE_STATUS = "failure"
        $($lib_alias)_LOAD_STATUS = "failure"
        return
    }

    $($lib_alias)_COMPILE_STATUS = "success"
    $($lib_alias)_PATH = "$output_lib_path"

    loadlib "$output_lib_path" "$lib_alias"

    libloaded "$lib_alias" __def_c_lib_loaded
    if $__def_c_lib_loaded == "1" {
        $($lib_alias)_LOAD_STATUS = "success"
        echo "def_c_lib: '$lib_alias' compiled and loaded from $output_lib_path"
    } else {
        $($lib_alias)_LOAD_STATUS = "failure"
        echo "def_c_lib: '$lib_alias' compiled but failed to load."
    }
}

echo "C Compiler Framework loaded ('def_c_lib <alias> <c_code_var> [cflags_var] [ldflags_var]')."
