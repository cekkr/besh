# BSH C Compiler Framework (c_compiler.bsh)
#
# Defines, compiles and loads C source held in a BSH variable as a shared
# library, using three shell primitives: 'writefile' to place the source on
# disk, 'process' to run the compiler with preserved argument boundaries, and
# 'loadlib' to bring the result into the process.
#
# The C ABI a compiled library must follow is fixed by src/bsh.c:
#   int func_name(int argc, char* argv[], char* output_buffer, int buffer_size)
# and results come back through $LAST_LIB_CALL_STATUS / $LAST_LIB_CALL_OUTPUT.
#
# This module is NOT used during startup: .bshrc keeps numbers and strings on
# the built-in primitives so that a plain shell session never depends on a C
# compiler being installed.
echo "Loading C Compiler Framework (c_compiler.bsh)..."

# --- Configuration ---
$BSH_C_COMPILE_TEMP_DIR = "/tmp/bsh_compile_cache"
$BSH_C_COMPILER = "cc"

# Sets "<alias>_COMPILE_STATUS" and friends. The name of the variable to write
# is built first and assigned through '$(...)', because '$($alias)_SUFFIX' reads
# as "the value of the variable named by $alias, then the literal text _SUFFIX"
# — which is not the variable this wants to touch.
function _c_lib_set_status (lib_alias field value) {
    $__c_lib_status_var = "${lib_alias}_${field}"
    $($__c_lib_status_var) = "$value"
}

# --- Main Function: Define, Compile, and Load C Library ---
# def_c_lib <alias> <c_code_var_name> [cflags_var_name] [ldflags_var_name]
#
# Sets, for alias X:
#   $X_COMPILE_STATUS   "success" | "failure"
#   $X_LOAD_STATUS      "success" | "failure"
#   $X_PATH             path of the produced shared object
#   $X_COMPILE_OUTPUT   compiler diagnostics (stdout and stderr merged)
function def_c_lib (lib_alias c_code_var_name compiler_flags_var linker_flags_var) {
    _c_lib_set_status "$lib_alias" "COMPILE_STATUS" "failure"
    _c_lib_set_status "$lib_alias" "LOAD_STATUS" "failure"
    _c_lib_set_status "$lib_alias" "COMPILE_OUTPUT" ""
    _c_lib_set_status "$lib_alias" "PATH" ""

    $c_source_code = $($c_code_var_name)
    if $c_source_code == "" {
        echo "def_c_lib: C source variable '$c_code_var_name' is empty."
        return
    }

    mkdir -p "$BSH_C_COMPILE_TEMP_DIR"

    $source_file_path = "${BSH_C_COMPILE_TEMP_DIR}/${lib_alias}.c"
    $output_lib_path = "${BSH_C_COMPILE_TEMP_DIR}/${lib_alias}.so"

    writefile "$source_file_path" $c_code_var_name
    if $LAST_FILE_STATUS != "0" {
        echo "def_c_lib: could not write '$source_file_path'."
        return
    }

    # 'process' is used rather than a bare command line because the program name
    # comes from a variable: a line starting with '$BSH_C_COMPILER' is parsed as
    # an expression, not dispatched as a command. 'process' also preserves every
    # argument boundary and captures the compiler's diagnostics.
    $cflags = ""
    if $compiler_flags_var != "" {
        $cflags = $($compiler_flags_var)
    }
    $ldflags = ""
    if $linker_flags_var != "" {
        $ldflags = $($linker_flags_var)
    }

    if $cflags == "" {
        if $ldflags == "" {
            process __c_lib_out "$BSH_C_COMPILER" "-shared" "-fPIC" "-o" "$output_lib_path" "$source_file_path"
        } else {
            process __c_lib_out "$BSH_C_COMPILER" "-shared" "-fPIC" "-o" "$output_lib_path" "$source_file_path" "$ldflags"
        }
    } else {
        if $ldflags == "" {
            process __c_lib_out "$BSH_C_COMPILER" "-shared" "-fPIC" "-o" "$output_lib_path" "$source_file_path" "$cflags"
        } else {
            process __c_lib_out "$BSH_C_COMPILER" "-shared" "-fPIC" "-o" "$output_lib_path" "$source_file_path" "$cflags" "$ldflags"
        }
    }
    _c_lib_set_status "$lib_alias" "COMPILE_OUTPUT" "$__c_lib_out"

    if $LAST_COMMAND_STATUS != "0" {
        echo "def_c_lib: compilation of '$lib_alias' failed (status $LAST_COMMAND_STATUS)."
        echo "$__c_lib_out"
        return
    }

    _c_lib_set_status "$lib_alias" "COMPILE_STATUS" "success"
    _c_lib_set_status "$lib_alias" "PATH" "$output_lib_path"

    loadlib "$output_lib_path" "$lib_alias"

    libloaded "$lib_alias" __def_c_lib_loaded
    if $__def_c_lib_loaded == "1" {
        _c_lib_set_status "$lib_alias" "LOAD_STATUS" "success"
    } else {
        echo "def_c_lib: '$lib_alias' compiled but failed to load."
    }
}

echo "C Compiler Framework loaded ('def_c_lib <alias> <c_code_var> [cflags_var] [ldflags_var]')."
