# .bshrc - default B[e]SH startup script.
#
# Executed when bsh starts (when $HOME/.bshrc does not exist). It defines the
# language: keyword aliases, the core frameworks, and a few conveniences.
#
# Numeric and string work is provided by framework/number.bsh and
# framework/string.bsh. Those modules use the native 'bshmath' /
# 'bshstringlib' shared libraries when they are loaded, and the shell's
# built-in 'prim' primitives otherwise, so startup does not depend on a
# working runtime C compiler.

echo "Executing .bshrc (B[e]SH startup)..."

# --- Core Settings & Aliases ---
$PS1 = "bsh-ng"
defkeyword defunc function

# --- Essential Framework Imports ---
import c_compiler     # def_c_lib: opt-in runtime C compilation
import number         # math_* helpers
import type           # get_type
import string         # string_* helpers
import core_operators # defoperator calls & BSH operator handlers

# --- Native libraries are opt-in ---
#
# Startup deliberately does NOT compile a native math library: a plain shell
# session must not depend on a C compiler being installed. Scripts that want the
# native path call def_c_lib themselves (see tests/native_lib.bsh); number.bsh
# and string.bsh pick it up automatically once the alias is loaded.
libloaded bshmath BSH_MATH_NATIVE
if $BSH_MATH_NATIVE == "1" {
    echo "Numbers: native 'bshmath' library in use."
} else {
    echo "Numbers: built-in primitives in use."
}

# --- Utility Functions ---
function is_empty (var_name_str result_var) {
    $temp_val = $($var_name_str)
    if $temp_val == "" {
        $($result_var) = "true"
    } else {
        $($result_var) = "false"
    }
}

function scope_test (param1) {
    echo "--- scope_test ---"
    echo "Param1 (local): $param1"
    $local_var = "I am local to scope_test"
    echo "Local_var (local): $local_var"

    $param_empty_res = ""
    is_empty param1 param_empty_res
    echo "Is param1 empty? $param_empty_res"
    echo "Global_var (from scope_test): $global_var_example"
    echo "--- end scope_test ---"
}

# Numeric for-loop over a command string, evaluated once per iteration.
function for_loop (iterator start_val end_val step command_body) {
    $($iterator) = $start_val

    if $step == "0" {
        echo "FOR_LOOP Error: Step value cannot be zero."
        return
    }

    $is_positive_step = "1"
    if $step < "0" {
        $is_positive_step = "0"
    }

    if $is_positive_step == "1" {
        while $($iterator) < $end_val {
            eval $command_body
            $__for_next = ""
            math_add "+" "$($iterator)" "$step" __for_next
            $($iterator) = "$__for_next"
        }
    } else {
        while $($iterator) > $end_val {
            eval $command_body
            $__for_next = ""
            math_add "+" "$($iterator)" "$step" __for_next
            $($iterator) = "$__for_next"
        }
    }
}

# --- End of .bshrc ---
$global_var_example = "I am a global variable set in .bshrc"
echo ".bshrc execution finished."
